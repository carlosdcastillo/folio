#!/usr/bin/env bash
set -euo pipefail

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

install_system_dependencies() {
  local packages=(
    build-essential
    curl
    file
    pkg-config
    libssl-dev
    libgtk-3-dev
    libwebkit2gtk-4.1-dev
    libxdo-dev
    libayatana-appindicator3-dev
    librsvg2-dev
  )
  local missing=()
  local package

  for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii '; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} == 0)); then
    echo "System dependencies are already installed."
    return
  fi

  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
}

install_rust() {
  export PATH="$HOME/.cargo/bin:$PATH"

  if ! command -v rustup >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
      sh -s -- -y --profile minimal --default-toolchain stable
  fi

  if ! command -v rustc >/dev/null 2>&1 ||
    [ "$(rustc --version | awk '{print $2}' | cut -d. -f1-2)" != "$(printf '%s\n' 1.85 "$(rustc --version | awk '{print $2}' | cut -d. -f1-2)" | sort -V | tail -n1)" ]; then
    rustup toolchain install stable --profile minimal
    rustup default stable
  fi

  local profile_marker="# folio Rust toolchain"
  touch "$HOME/.bash_profile"
  if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
    cat >>"$HOME/.bash_profile" <<'EOF'

# folio Rust toolchain
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi
EOF
  fi

  rustc --version
  cargo --version
}

check_node() {
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "Node.js 18+ and npm are required but are not available in the orb image." >&2
    return 1
  fi

  local major
  major="$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
  if ((major < 18)); then
    echo "Node.js 18+ is required; found $(node --version)." >&2
    return 1
  fi

  node --version
  npm --version
}

step "Install Tauri system dependencies" install_system_dependencies
step "Install the Rust toolchain" install_rust
step "Check the Node.js toolchain" check_node
step "Install locked frontend dependencies" npm ci --prefix ui
step "Fetch locked Rust dependencies" cargo fetch --locked
step "Build the workspace" cargo build --locked --workspace

printf '\nOrb setup complete in %ss.\n' "$SECONDS"
